{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@acme/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "preserve",
    "paths": {
      "~/*": ["./src/*"],
      "@acme/ui/*": ["../../@acme/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "module": "esnext",
    "strictNullChecks": true
  },
  "include": [".", ".next/types/**/*.ts"],
  // eslint.config.ts pulls @acme/eslint-config source (.ts imports needing
  // allowImportingTsExtensions); that package typechecks itself. Matches manager.
  "exclude": ["node_modules", "eslint.config.ts"],
  "references": [{ "path": "../../@acme/ui/tsconfig.build.json" }]
}
