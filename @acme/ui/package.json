  "name": "@acme/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*",
    "./shadcn/*": "./src/shadcn/*",
    "./lib/*": "./src/lib/*",
    "./hooks/*": "./src/hooks/*",
    "./styles/*": "./src/styles/*",
    "./postcss.cjs": "./postcss.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "chromatic": "chromatic --project-token=chpt_c9c2d477ce70b1e --exit-zero-on-changes",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../.gitignore --ignore-path ./.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "registry:build": "cd src && pnpm dlx shadcn build ./registry.json -o ../public/registry",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:preview": "serve storybook-static",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --project unit --run",
    "test:storybook": "vitest --project storybook --run",
    "test:editor:notion-clipboard": "playwright test --config ./playwright.editor-clipboard.config.mjs",
    "trace": "tsc --generateTrace .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --emitDeclarationOnly false",
    "ui-add": "pnpm dlx shadcn@latest add && prettier src --write --list-different"
  },
